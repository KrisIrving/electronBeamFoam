#!/bin/bash
set -euo pipefail

# Reconstruct a parallel dynamicRefineFvMesh case.
#
# Why reconstructParMesh is required:
# dynamicRefineFvMesh writes new processor-local polyMesh instances whenever
# topology changes.  Those time directories do not contain the procAddressing
# generated by the original decomposePar, so reconstructPar alone cannot map
# fields back to the serial mesh.
#
# For every processor0 time that contains a new polyMesh/points instance:
#   1. reconstruct the mesh and write fresh procAddressing;
#   2. reconstruct all fields;
#   3. create case.foam for ParaView.

if [ ! -d processor0 ]; then
    echo "ERROR: processor0 not found. Nothing to reconstruct." >&2
    exit 1
fi

mapfile -t meshTimes < <(
    for meshDir in processor0/*/polyMesh; do
        [ -d "$meshDir" ] || continue
        [ -f "$meshDir/points" ] || continue
        basename "$(dirname "$meshDir")"
    done | sort -g -u
)

if [ "${#meshTimes[@]}" -gt 0 ]; then
    echo "Dynamic mesh instances: ${meshTimes[*]}"

    for t in "${meshTimes[@]}"; do
        echo "Reconstructing mesh/addressing at time $t"
        reconstructParMesh -time "$t" \
            > "log.reconstructParMesh.$t" 2>&1
    done
else
    echo "No time-varying processor polyMesh found; using constant addressing."
fi

echo "Reconstructing fields"
reconstructPar > log.reconstructPar 2>&1

touch case.foam

echo "Reconstruction complete."
echo "ParaView marker: $(pwd)/case.foam"
