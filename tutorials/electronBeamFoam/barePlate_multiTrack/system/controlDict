FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     electronBeamFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.0035;

deltaT          1.0e-9;

writeControl    adjustableRunTime;

writeInterval   1e-04;

purgeWrite      0;

writeFormat     binary;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

// Lightweight stage timing, reported only at write times.
performanceProfiling true;

// Per-corrector epsilon1 residual output creates very large logs in long EPBF
// runs. Performance summaries still report thermal-corrector counts.
thermalCorrectorVerbose false;

adjustTimeStep  yes;

maxCo           0.25;//0.1;
maxAlphaCo      0.25;

maxDeltaT       1e-6;


// ************************************************************************* //
