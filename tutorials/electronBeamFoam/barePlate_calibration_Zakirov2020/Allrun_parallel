#!/bin/bash
set -euo pipefail

# Hold an advisory lock for the complete case run. This prevents two
# Allrun_parallel instances from deleting/reusing the same processor*,
# postProcessing and log files.
exec 9>.electronBeamFoam.run.lock
if ! flock -n 9; then
    echo "ERROR: another electronBeamFoam run already owns this case directory." >&2
    echo "Use ./Status or wait for the active run to finish." >&2
    exit 2
fi

# Quiet MPI run for electronBeamFoam.
# Usage:
#   NPROCS=48 ./Allrun_parallel
# All OpenFOAM output is written to log.* files, not the terminal.

NPROCS="${NPROCS:-48}"
MESH_PROFILE="${MESH_PROFILE:-uniformFine}"

case "$MESH_PROFILE" in
    uniformFine|gradedY|gradedYSmooth) ;;
    *)
        echo "ERROR: unknown MESH_PROFILE '$MESH_PROFILE'." >&2
        echo "Valid values: uniformFine, gradedY, gradedYSmooth" >&2
        exit 1
        ;;
esac

# Check that the solver executable is not stale relative to the source tree.
# A stale binary can silently omit newly added diagnostics after git pull.
SOLVER_EXE="$(command -v electronBeamFoam || true)"
if [ -z "$SOLVER_EXE" ] || [ ! -x "$SOLVER_EXE" ]; then
    echo "ERROR: electronBeamFoam executable not found in PATH." >&2
    echo "Run ./Allwmake from the repository root first." >&2
    exit 1
fi

REPO_ROOT="$(cd ../../.. && pwd)"
if find "$REPO_ROOT/applications/solvers/electronBeamFoam"         "$REPO_ROOT/src/electronBeamHeatSource"         -type f \( -name '*.C' -o -name '*.H' -o -name 'files' -o -name 'options' \)         -newer "$SOLVER_EXE" -print -quit | grep -q .; then
    echo "ERROR: electronBeamFoam executable is older than solver/source files." >&2
    echo "Rebuild with: cd $REPO_ROOT && ./Allwmake" >&2
    exit 1
fi

# Preserve tracked runtime-control files so environment-driven parameter sweeps
# leave the Git worktree clean after the run.
RUN_INPUT_BACKUP="$(mktemp -d)"
cp system/controlDict "$RUN_INPUT_BACKUP/controlDict"
cp constant/timeVsBeamPosition "$RUN_INPUT_BACKUP/timeVsBeamPosition"
cp constant/timeVsBeamPower "$RUN_INPUT_BACKUP/timeVsBeamPower"
cp constant/ElectronBeamProperties "$RUN_INPUT_BACKUP/ElectronBeamProperties"
cp constant/transportProperties "$RUN_INPUT_BACKUP/transportProperties"
cp initial/T "$RUN_INPUT_BACKUP/T"
cp system/fvSolution "$RUN_INPUT_BACKUP/fvSolution"
cp system/blockMeshDict "$RUN_INPUT_BACKUP/blockMeshDict"

restore_run_inputs()
{
    cp "$RUN_INPUT_BACKUP/controlDict" system/controlDict
    cp "$RUN_INPUT_BACKUP/timeVsBeamPosition" constant/timeVsBeamPosition
    cp "$RUN_INPUT_BACKUP/timeVsBeamPower" constant/timeVsBeamPower
    cp "$RUN_INPUT_BACKUP/ElectronBeamProperties" constant/ElectronBeamProperties
    cp "$RUN_INPUT_BACKUP/transportProperties" constant/transportProperties
    cp "$RUN_INPUT_BACKUP/T" initial/T
    cp "$RUN_INPUT_BACKUP/fvSolution" system/fvSolution
    cp "$RUN_INPUT_BACKUP/blockMeshDict" system/blockMeshDict
    rm -rf "$RUN_INPUT_BACKUP"
}
trap restore_run_inputs EXIT INT TERM

python3 generateCalibrationTrack.py > log.generateTrack 2>&1
echo "  mesh profile   = $MESH_PROFILE" >> log.generateTrack

case "$MESH_PROFILE" in
    uniformFine)
        ;;
    gradedY)
        cp system/blockMeshDict.gradedY system/blockMeshDict
        ;;
    gradedYSmooth)
        cp system/blockMeshDict.gradedYSmooth system/blockMeshDict
        ;;
esac

# Fresh initial field directory. Remove stale serial reconstruction
# times as well, otherwise ParaView can mix data from previous runs.
rm -rf 0 processor*
rm -rf postProcessing
rm -f calibration-comparison.txt
rm -f case.foam
foamListTimes -rm -noZero > log.cleanTimes 2>&1 || true
cp -r initial 0
find 0 -name "*.orig" -exec bash -c 'cp "$0" "${0%.orig}"' {} \;

# Keep decomposeParDict and mpirun consistent.
foamDictionary system/decomposeParDict \
    -entry numberOfSubdomains -set "$NPROCS" \
    > log.setNProcs 2>&1

blockMesh > log.blockMesh 2>&1
checkMesh -constant -allGeometry -allTopology > log.checkMesh 2>&1
if grep -q "Failed" log.checkMesh; then
    echo "ERROR: checkMesh reported a failure for MESH_PROFILE=$MESH_PROFILE" >&2
    tail -80 log.checkMesh >&2
    exit 1
fi
setFields > log.setFields 2>&1
decomposePar -force > log.decomposePar 2>&1

# One MPI rank per physical core. Keep OpenMP libraries single-threaded to
# avoid accidental oversubscription.  The user's workstation has two sockets
# with 24 physical cores/socket.  For even NPROCS <= 48, distribute ranks
# symmetrically across both sockets to reduce NUMA imbalance.
export OMP_NUM_THREADS=1

MPI_ARGS=()
if [ "${NUMA_BIND:-1}" = "1" ] && [ "$NPROCS" -le 48 ] && [ $((NPROCS % 2)) -eq 0 ]; then
    PPR=$((NPROCS / 2))
    MPI_ARGS+=(--bind-to core --map-by "ppr:${PPR}:socket")
fi

mpirun "${MPI_ARGS[@]}" -np "$NPROCS" electronBeamFoam -parallel \
    > log.electronBeamFoam 2>&1

python3 CompareExperiment.py > calibration-comparison.txt 2>&1 || true

# Reconstruct dynamic mesh + fields after a successful solver run.
# Set AUTO_RECONSTRUCT=0 to keep the decomposed result only.
if [ "${AUTO_RECONSTRUCT:-1}" = "1" ]; then
    ./Reconstruct > log.Reconstruct 2>&1
fi
