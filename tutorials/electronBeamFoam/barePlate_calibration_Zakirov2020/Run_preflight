#!/bin/bash
set -euo pipefail

MODE="${1:-preflight}"

start_background()
{
    local worker="$1"
    local log="$2"
    local label="$3"
    local state_file="${4:-}"
    local failure_file="${5:-}"

    if [ -f run.pid ]; then
        local old_pid
        old_pid="$(cat run.pid 2>/dev/null || true)"
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            echo "ERROR: run.pid points to a live process $old_pid." >&2
            echo "Use ./Status instead of launching another run." >&2
            return 2
        fi
    fi

    rm -f "$failure_file"

    if ! bash -n "$worker"; then
        echo "ERROR: shell syntax check failed for $worker; not starting." >&2
        return 1
    fi

    nohup bash "$worker" > "$log" 2>&1 &
    local pid=$!
    echo "$pid" > run.pid

    echo "Starting $label worker PID $pid ..."
    sleep 1

    if kill -0 "$pid" 2>/dev/null; then
        echo "STARTED: $label"
        if [ -n "$state_file" ] && [ -f "$state_file" ]; then
            echo "Current workflow state:"
            sed 's/^/  /' "$state_file"
        else
            echo "Worker is alive; state file has not been written yet."
        fi
        echo "Monitor with: ./Status"
        echo "Workflow log: $log"
        return 0
    fi

    # A short post-processing/resume workflow can legitimately finish
    # during the one-second startup observation window. Treat an explicit
    # complete state with no failure marker as success, not as a launch error.
    if [ -n "$state_file" ] \
       && [ -f "$state_file" ] \
       && grep -qx 'stage=complete' "$state_file" \
       && { [ -z "$failure_file" ] || [ ! -f "$failure_file" ]; }; then
        echo "COMPLETED: $label"
        sed 's/^/  /' "$state_file"
        if [ -f "$log" ] && [ -s "$log" ]; then
            echo "Workflow log tail:"
            tail -20 "$log" | sed 's/^/  /'
        fi
        return 0
    fi

    echo "ERROR: $label worker exited immediately." >&2
    if [ -n "$failure_file" ] && [ -f "$failure_file" ]; then
        echo "Failure marker:" >&2
        sed 's/^/  /' "$failure_file" >&2
    fi
    if [ -f "$log" ]; then
        echo "Workflow log: $log" >&2
        echo "Last workflow log lines:" >&2
        if [ -s "$log" ]; then
            tail -40 "$log" | sed 's/^/  /' >&2
        else
            echo "  (log file exists but is empty)" >&2
        fi
    else
        echo "Workflow log was not created: $log" >&2
    fi
    return 1
}

case "$MODE" in
    preflight)
        # Cheap geometry/source preflight only. It is NOT the final
        # experimental comparison because the track is shortened to 0.5 mm.
        X_START=-0.00025 \
        X_END=0.00025 \
        AUTO_RECONSTRUCT=0 \
        ./Run_background
        ;;
    vacuum|vacuum-fidelity)
        # Vacuum-fidelity V0 baseline: same 0.5 mm trajectory, but force the
        # accepted 48-rank simpleXZ engineering decomposition. The calibration
        # EPBFPhysicsProperties enables the evaporation mass diagnostics.
        X_START=-0.00025 \
        X_END=0.00025 \
        DECOMP_PROFILE=simpleXZ \
        AUTO_RECONSTRUCT=0 \
        ./Run_background
        ;;
    kappa|kappa-sweep|vacuum-kappa)
        start_background \
            ./Allrun_vacuumKappaSweep \
            log.Allrun.vacuumKappaSweep \
            "Vacuum Fidelity V1 kappa sweep" \
            vacuum-kappa-sweep-state.txt \
            vacuum-kappa-sweep-failure.txt
        ;;
    kappa-limit|kappa-convergence|vacuum-kappa-limit)
        start_background \
            ./Allrun_vacuumKappaConvergence \
            log.Allrun.vacuumKappaConvergence \
            "Vacuum Fidelity V1b low-k convergence" \
            vacuum-kappa-convergence-state.txt \
            vacuum-kappa-convergence-failure.txt
        ;;
    *)
        echo "Usage: $0 [preflight|vacuum|kappa|kappa-limit]" >&2
        exit 2
        ;;
esac
