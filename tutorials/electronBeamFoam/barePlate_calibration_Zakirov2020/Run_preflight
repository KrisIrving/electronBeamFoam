#!/bin/bash
set -euo pipefail

MODE="${1:-preflight}"

case "$MODE" in
    preflight)
        # Cheap geometry/source preflight only. It is NOT the final
        # experimental comparison because the track is shortened to 0.5 mm.
        X_START=-0.00025 \
        X_END=0.00025 \
        AUTO_RECONSTRUCT=0 \
        ./Run_background
        ;;
    vacuum|vacuum-fidelity)
        # Vacuum-fidelity V0 baseline: same 0.5 mm trajectory, but force the
        # accepted 48-rank simpleXZ engineering decomposition. The calibration
        # EPBFPhysicsProperties enables the evaporation mass diagnostics.
        X_START=-0.00025 \
        X_END=0.00025 \
        DECOMP_PROFILE=simpleXZ \
        AUTO_RECONSTRUCT=0 \
        ./Run_background
        ;;
    kappa|kappa-sweep|vacuum-kappa)
        if [ -f run.pid ]; then
            OLD_PID="$(cat run.pid 2>/dev/null || true)"
            if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
                echo "ERROR: run.pid points to a live process $OLD_PID." >&2
                echo "Use ./Status instead of launching another run." >&2
                exit 2
            fi
        fi

        nohup bash ./Allrun_vacuumKappaSweep \
            > log.Allrun.vacuumKappaSweep 2>&1 &
        echo $! > run.pid
        echo "Started Vacuum Fidelity V1 kappa sweep PID $(cat run.pid)"
        ;;
    kappa-limit|kappa-convergence|vacuum-kappa-limit)
        if [ -f run.pid ]; then
            OLD_PID="$(cat run.pid 2>/dev/null || true)"
            if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
                echo "ERROR: run.pid points to a live process $OLD_PID." >&2
                echo "Use ./Status instead of launching another run." >&2
                exit 2
            fi
        fi

        nohup bash ./Allrun_vacuumKappaConvergence \
            > log.Allrun.vacuumKappaConvergence 2>&1 &
        echo $! > run.pid
        echo "Started Vacuum Fidelity V1b low-k convergence PID $(cat run.pid)"
        ;;
    *)
        echo "Usage: $0 [preflight|vacuum|kappa|kappa-limit]" >&2
        exit 2
        ;;
esac
