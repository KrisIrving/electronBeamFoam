#!/bin/bash
set -euo pipefail

guard_no_active_run()
{
    exec 7>.electronBeamFoam.run.lock
    if ! flock -n 7; then
        echo "ERROR: an electronBeamFoam run is already active in this case." >&2
        echo "Use ./Status instead of launching a second PIMPLE probe." >&2
        exit 2
    fi
    flock -u 7
}
guard_no_active_run

# Strict A/B against the accepted PCG/DIC + 3 pressure-corrector baseline.
# Only nCorrectors changes from 3 to 2; the final pressure solve remains
# p_rghFinal with relTol=0.
EPSILON_TOLERANCE=1e-3 \
MESH_PROFILE=gradedYSmooth \
PRESSURE_PROFILE=pcg \
PIMPLE_PROFILE=pCorr2 \
X_START=-0.00025 \
X_END=0.00025 \
AUTO_RECONSTRUCT=0 \
./Run_background
