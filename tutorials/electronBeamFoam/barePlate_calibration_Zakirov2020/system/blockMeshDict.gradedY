FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

convertToMeters 0.001;

vertices
(
    (-2.2 0    0)    // 0
    ( 2.2 0    0)    // 1
    ( 2.2 0.15 0)    // 2
    (-2.2 0.15 0)    // 3
    ( 2.2 0.35 0)    // 4
    (-2.2 0.35 0)    // 5
    ( 2.2 0.60 0)    // 6
    (-2.2 0.60 0)    // 7

    (-2.2 0    1.5)  // 8
    ( 2.2 0    1.5)  // 9
    ( 2.2 0.15 1.5)  // 10
    (-2.2 0.15 1.5)  // 11
    ( 2.2 0.35 1.5)  // 12
    (-2.2 0.35 1.5)  // 13
    ( 2.2 0.60 1.5)  // 14
    (-2.2 0.60 1.5)  // 15
);

blocks
(
    // Vacuum/headspace: dy = 12.5 um
    hex (0 1 2 3 8 9 10 11)       (176 12 60) simpleGrading (1 1 1)

    // Free-surface + near-substrate band: dy = 6.25 um
    // Initial surface y=0.20 mm lies exactly on a cell face.
    // The fine substrate band extends 150 um below the initial surface.
    hex (3 2 4 5 11 10 12 13)     (176 32 60) simpleGrading (1 1 1)

    // Deep substrate: dy = 25 um
    hex (5 4 6 7 13 12 14 15)     (176 10 60) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    lowerWall
    {
        type wall;
        faces
        (
            (7 15 14 6)
        );
    }

    atmosphere
    {
        type patch;
        faces
        (
            (1 9 8 0)
        );
    }

    rightWall
    {
        type patch;
        faces
        (
            (1 2 10 9)
            (2 4 12 10)
            (4 6 14 12)
        );
    }

    leftWall
    {
        type patch;
        faces
        (
            (0 8 11 3)
            (3 11 13 5)
            (5 13 15 7)
        );
    }

    frontAndBack
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (3 5 4 2)
            (5 7 6 4)
            (9 10 11 8)
            (10 12 13 11)
            (12 14 15 13)
        );
    }
);

mergePatchPairs
(
);

