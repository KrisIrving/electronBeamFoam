#!/bin/bash
set -euo pipefail

LOG="${1:-log.electronBeamFoam}"
OUT="${2:-run-summary.txt}"

if [ ! -f "$LOG" ]; then
    echo "ERROR: $LOG not found" >&2
    exit 1
fi

{
    echo "# electronBeamFoam compact run summary"
    echo "# source log: $LOG"
    echo

    echo "## Solver build"
    grep '^electronBeamFoam build tag = ' "$LOG" | head -1 || true
    echo

    if [ -f log.generateTrack ]; then
        echo "## Generated track"
        cat log.generateTrack
        echo
    fi

    echo "## Beam diagnostics at write times"
    grep -E '^(Electron beam:|    position             =|    surface tracking     =|    beamlets             =|    beamlets hit metal   =|    hit power fraction   =|    first-hit mean dist  =|    first-hit min dist   =|    first-hit max dist   =|    incident power       =|    requested absorbed   =|    effective absorbed   =|    integrated deposited =|    power error          =)'         "$LOG" || true
    echo

    echo "## Melt-pool diagnostics"
    awk '
        /^Melt-pool diagnostics$/ {active=1; print; next}
        /^Fusion-zone diagnostics$/ {active=0}
        /^Performance profile:/ {active=0}
        active && /^    (cells|length|width|depth|volume|Tmax|Umax|recoil max)[[:space:]]*=/ {print}
    ' "$LOG" || true
    echo

    echo "## Fusion-zone diagnostics"
    awk '
        /^Fusion-zone diagnostics$/ {active=1; print; next}
        /^Melt-pool diagnostics$/ {active=0}
        /^Fusion-zone section diagnostics$/ {active=0}
        /^Performance profile:/ {active=0}
        active && /^    (cells|length|width|depth|volume|peak Tmax)[[:space:]]*=/ {print}
    ' "$LOG" || true
    echo

    echo "## Fusion-zone section diagnostics"
    if [ -f postProcessing/meltPoolDiagnostics/fusionZoneSections.csv ]; then
        python3 - <<'PY' || true
import csv
from pathlib import Path

path = Path("postProcessing/meltPoolDiagnostics/fusionZoneSections.csv")
with path.open(newline="") as f:
    rows = list(csv.DictReader(f))

if rows:
    final_time = max(float(r["time_s"]) for r in rows)
    print(f"final section time      = {final_time:.12g} s")
    for r in rows:
        if abs(float(r["time_s"]) - final_time) <= 1e-14:
            print(
                "section station={:+.6e} m cells={} width={:.12g} m "
                "depth={:.12g} m peakT={:.12g} K".format(
                    float(r["station_m"]),
                    r["sectionCells"],
                    float(r["width_m"]),
                    float(r["depth_m"]),
                    float(r["peakTmax_K"]),
                )
            )
PY
    else
        echo "no fusionZoneSections.csv"
    fi
    echo

    echo "## Performance profiles"
    grep -E '^(Performance profile:|    steps                =|    PIMPLE iterations    =|    pressure correctors  =|    thermal correctors   =|    max thermal/TEqn     =|    thermal cap hits     =|    thermal final resid  =|    thermal conv resid   =|    thermal resid bulk   =|    thermal resid iface  =|    thermal resid void   =|    thermal cap regions  =|    deltaT min/mean/max  =|    global cells         =|    wall total           =|    mesh update          =|    VOF/interface        =|    properties           =|    electron beam        =|    momentum             =|    thermal/phase        =|    pressure             =|    turbulence           =|    write I/O            =|    other                =)'         "$LOG" || true
    echo

    echo "## Continuity diagnostics"
    python3 - "$LOG" <<'PY' || true
import re
import sys
from pathlib import Path

log = Path(sys.argv[1])
pat = re.compile(
    r"time step continuity errors\s*:\s*"
    r"sum local\s*=\s*([0-9.eE+-]+),\s*"
    r"global\s*=\s*([0-9.eE+-]+),\s*"
    r"cumulative\s*=\s*([0-9.eE+-]+)"
)

rows = []
for line in log.open(errors="replace"):
    m = pat.search(line)
    if m:
        rows.append(tuple(float(x) for x in m.groups()))

if not rows:
    print("continuity samples       = 0")
else:
    local = [abs(r[0]) for r in rows]
    glob = [abs(r[1]) for r in rows]
    cum = [r[2] for r in rows]
    print(f"continuity samples       = {len(rows)}")
    print(f"continuity max local     = {max(local):.12g}")
    print(f"continuity max global    = {max(glob):.12g}")
    print(f"continuity final cumul   = {cum[-1]:.12g}")
    print(f"continuity max abs cumul = {max(abs(x) for x in cum):.12g}")
PY
    echo

    echo "## Experimental comparison"
    if [ -f calibration-comparison.txt ]; then
        cat calibration-comparison.txt
    elif [ -f postProcessing/meltPoolDiagnostics/fusionZone.csv ]; then
        python3 CompareExperiment.py 2>/dev/null || true
    fi
    echo

    echo "## Final runtime / termination"
    grep -E '^(ExecutionTime =|End$|FOAM FATAL ERROR|FOAM Warning)' "$LOG" | tail -5 || true
} > "$OUT"

echo "Wrote $OUT"
