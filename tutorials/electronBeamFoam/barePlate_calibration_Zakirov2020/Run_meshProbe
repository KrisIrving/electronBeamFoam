#!/bin/bash
set -euo pipefail

# Mesh-cost A/B probe. Run only after the epsilonTolerance=1e-3 probe has
# completed and its numerical/physical result has been accepted.
BASELINE_DIR="comparisons/preflight_tol1e-3_uniformFine"

if [ -f log.electronBeamFoam ]; then
    ./SummarizeRun >/dev/null
fi

if [ ! -f run-summary.txt ] ||    [ ! -f postProcessing/meltPoolDiagnostics/fusionZone.csv ]; then
    echo "ERROR: no completed tol=1e-3 uniformFine preflight to archive." >&2
    echo "Finish Run_toleranceProbe and review CompareTolerance.py first." >&2
    exit 1
fi

mkdir -p "$BASELINE_DIR"
cp run-summary.txt "$BASELINE_DIR/"
cp postProcessing/meltPoolDiagnostics/fusionZone.csv "$BASELINE_DIR/"
[ -f postProcessing/meltPoolDiagnostics/meltPool.csv ] &&     cp postProcessing/meltPoolDiagnostics/meltPool.csv "$BASELINE_DIR/"
[ -f calibration-comparison.txt ] &&     cp calibration-comparison.txt "$BASELINE_DIR/"

EPSILON_TOLERANCE=1e-3 MESH_PROFILE=gradedY X_START=-0.00025 X_END=0.00025 AUTO_RECONSTRUCT=0 ./Run_background
