#!/bin/bash
# Compact status only; does not follow the full solver output.
LOG=log.electronBeamFoam
if [ ! -f "$LOG" ]; then
    echo "No $LOG yet."
    exit 0
fi
if [ -f log.generateTrack ]; then
    echo '--- Calibration input ---'
    cat log.generateTrack
    echo '--------------------------'
fi
printf 'Latest simulation time: '
grep '^[[:space:]]*Time = ' "$LOG" | tail -1 || true
printf 'Latest execution time : '
grep 'ExecutionTime = ' "$LOG" | tail -1 || true
printf 'Latest deltaT         : '
grep 'deltaT = ' "$LOG" | tail -1 || true
# Legacy centralFirstHit distance is intentionally omitted here. For the
# current multiRayFirstHit model, the mean/min/max first-hit diagnostics below
# are the relevant quantities.
printf 'Latest power error    : '
grep 'power error' "$LOG" | tail -1 || true

printf 'Latest tracking mode   : '
grep 'surface tracking' "$LOG" | tail -1 || true
printf 'Latest beamlet hits    : '
grep 'beamlets hit metal' "$LOG" | tail -1 || true
printf 'Latest hit fraction    : '
grep 'hit power fraction' "$LOG" | tail -1 || true
printf 'Latest first-hit mean  : '
grep 'first-hit mean dist' "$LOG" | tail -1 || true
printf 'Latest first-hit min   : '
grep 'first-hit min dist' "$LOG" | tail -1 || true
printf 'Latest first-hit max   : '
grep 'first-hit max dist' "$LOG" | tail -1 || true

printf 'Latest profile total   : '
grep 'wall total' "$LOG" | tail -1 || true
printf 'Latest thermal share   : '
grep 'thermal/phase' "$LOG" | tail -1 || true
printf 'Latest pressure share  : '
grep '    pressure             =' "$LOG" | tail -1 || true
printf 'Latest beam share      : '
grep 'electron beam' "$LOG" | tail -1 || true

echo 'Latest melt-pool:'
if [ -f postProcessing/meltPoolDiagnostics/meltPool.csv ]; then
    tail -1 postProcessing/meltPoolDiagnostics/meltPool.csv | \
    awk -F',' '
    {
        printf "  L = %8.3f um    W = %8.3f um\n", $3*1e6, $4*1e6;
        printf "  D = %8.3f um    V = %8.6f mm^3\n", $5*1e6, $6*1e9;
        printf "  Tmax = %8.2f K  Umax = %8.3f m/s\n", $7, $8;
        printf "  recoil = %8.3f kPa  cells = %d\n", $9/1e3, $2;
    }'
else
    echo '  no meltPool.csv yet'
fi

echo 'Latest fusion-zone:'
if [ -f postProcessing/meltPoolDiagnostics/fusionZone.csv ]; then
    tail -1 postProcessing/meltPoolDiagnostics/fusionZone.csv | \
    awk -F',' '
    {
        printf "  L = %8.3f um    W = %8.3f um\n", $3*1e6, $4*1e6;
        printf "  D = %8.3f um    V = %8.6f mm^3\n", $5*1e6, $6*1e9;
        printf "  peakT = %8.2f K  cells = %d\n", $7, $2;
    }'
else
    echo '  no fusionZone.csv yet'
fi

echo 'Experiment comparison:'
if [ -f calibration-comparison.txt ]; then
    sed 's/^/  /' calibration-comparison.txt
elif [ -f postProcessing/meltPoolDiagnostics/fusionZone.csv ]; then
    python3 CompareExperiment.py 2>/dev/null | sed 's/^/  /' || true
else
    echo '  no completed fusionZone.csv yet'
fi

echo 'Run health:'
ACTIVE=0
if [ -f run.pid ]; then
    RP="$(cat run.pid 2>/dev/null || true)"
    if [ -n "$RP" ] && kill -0 "$RP" 2>/dev/null; then
        ACTIVE=1
        printf '  Allrun PID = %s (active)\n' "$RP"
    else
        printf '  run.pid = %s (not active)\n' "${RP:-unknown}"
    fi
else
    echo '  no run.pid'
fi

if [ -f "$LOG" ]; then
    NOW="$(date +%s)"
    MTIME="$(stat -c %Y "$LOG" 2>/dev/null || echo "$NOW")"
    AGE=$((NOW - MTIME))
    printf '  log age = %d s\n' "$AGE"

    if [ "$ACTIVE" -eq 1 ] && [ "$AGE" -ge 300 ]; then
        echo '  WARNING: active process but solver log has not advanced for >=300 s.'
        echo '  Last solver lines:'
        tail -8 "$LOG" | sed 's/^/    /'
        if tail -20 "$LOG" | grep -Eq 'Selected .*cells for refinement|Refined from|Unrefined from'; then
            echo '  Suspect stage: dynamic mesh topology update / field mapping.'
        fi
    fi
fi
