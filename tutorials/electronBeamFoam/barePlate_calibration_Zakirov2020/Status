import subprocess
import sys
from collections import defaultdict, deque

root = int(sys.argv[1])

try:
    text = subprocess.check_output(
        ["ps", "-eo", "pid=,ppid=,args="],
        text=True,
        errors="replace",
    )
except Exception:
    raise SystemExit(0)

children = defaultdict(list)
cmd = {}

for line in text.splitlines():
    parts = line.strip().split(None, 2)
    if len(parts) < 2:
        continue
    try:
        pid = int(parts[0])
        ppid = int(parts[1])
    except ValueError:
        continue
    children[ppid].append(pid)
    cmd[pid] = parts[2] if len(parts) > 2 else ""

queue = deque(children.get(root, []))
seen = set()

while queue:
    pid = queue.popleft()
    if pid in seen:
        continue
    seen.add(pid)

    c = cmd.get(pid, "")
    if "mpirun" in c and "electronBeamFoam" in c:
        print(pid)
        break

    queue.extend(children.get(pid, []))
PY
