#!/bin/bash
# Compact status only; does not follow the full solver output.
LOG=log.electronBeamFoam
if [ ! -f "$LOG" ]; then
    echo "No $LOG yet."
    exit 0
fi
if [ -f log.generateTrack ]; then
    echo '--- Calibration input ---'
    cat log.generateTrack
    echo '--------------------------'
fi
printf 'Latest simulation time: '
grep '^[[:space:]]*Time = ' "$LOG" | tail -1 || true
printf 'Latest execution time : '
grep 'ExecutionTime = ' "$LOG" | tail -1 || true
printf 'Latest deltaT         : '
grep 'deltaT = ' "$LOG" | tail -1 || true

echo 'Recent simulation throughput:'
python3 - "$LOG" <<'PY' || true
import re
import sys
from pathlib import Path

log = Path(sys.argv[1])
time_re = re.compile(r"^\s*Time = ([0-9.eE+-]+)")
timing_re = re.compile(
    r"^ExecutionTime = ([0-9.eE+-]+) s\s+ClockTime = ([0-9.eE+-]+) s"
)
pairs = []
cur_t = None
with log.open(errors="replace") as f:
    for line in f:
        m = time_re.match(line)
        if m:
            cur_t = float(m.group(1))
            continue
        m = timing_re.match(line)
        if m and cur_t is not None:
            pairs.append((cur_t, float(m.group(1)), float(m.group(2))))

if len(pairs) < 2:
    print("  insufficient completed time-step samples")
else:
    def report(label, seq):
        t0, cpu0, wall0 = seq[0]
        t1, cpu1, wall1 = seq[-1]
        ds_us = (t1 - t0)*1e6
        dcpu = cpu1 - cpu0
        dwall = wall1 - wall0
        if ds_us <= 0 or dwall <= 0:
            print(f"  {label}: unavailable")
            return

        wall_sec_per_us = dwall/ds_us
        sim_us_per_wall_hr = 3600.0/wall_sec_per_us
        eta_hr = max(0.0, (1.0e-3 - t1)*1e6*wall_sec_per_us/3600.0)

        cpu_sec_per_us = dcpu/ds_us if dcpu > 0 else float("nan")
        cpu_wall_ratio = dcpu/dwall if dcpu > 0 else float("nan")

        print(
            f"  {label}: {wall_sec_per_us:.2f} wall-s/sim-us  "
            f"({sim_us_per_wall_hr:.2f} sim-us/wall-h), ETA~{eta_hr:.1f} h"
        )
        print(
            f"    master CPU: {cpu_sec_per_us:.2f} cpu-s/sim-us, "
            f"CPU/Clock={cpu_wall_ratio:.3f}"
        )

    report("recent 200 steps", pairs[-200:])
    report("since resume log", pairs)
PY
# Legacy centralFirstHit distance is intentionally omitted here. For the
# current multiRayFirstHit model, the mean/min/max first-hit diagnostics below
# are the relevant quantities.
printf 'Latest power error    : '
grep 'power error' "$LOG" | tail -1 || true

printf 'Latest tracking mode   : '
grep 'surface tracking' "$LOG" | tail -1 || true
printf 'Latest beamlet hits    : '
grep 'beamlets hit metal' "$LOG" | tail -1 || true
printf 'Latest hit fraction    : '
grep 'hit power fraction' "$LOG" | tail -1 || true
printf 'Latest first-hit mean  : '
grep 'first-hit mean dist' "$LOG" | tail -1 || true
printf 'Latest first-hit min   : '
grep 'first-hit min dist' "$LOG" | tail -1 || true
printf 'Latest first-hit max   : '
grep 'first-hit max dist' "$LOG" | tail -1 || true

printf 'Latest profile total   : '
grep 'wall total' "$LOG" | tail -1 || true
printf 'Latest thermal share   : '
grep 'thermal/phase' "$LOG" | tail -1 || true
printf 'Latest pressure share  : '
grep '    pressure             =' "$LOG" | tail -1 || true
printf 'Latest beam share      : '
grep 'electron beam' "$LOG" | tail -1 || true
printf 'Latest local cells     : '
grep 'local cells min/max' "$LOG" | tail -1 || true
printf 'Latest cell imbalance  : '
grep 'cell imbalance max/mean' "$LOG" | tail -1 || true
printf 'Latest heaviest rank   : '
grep 'heaviest rank' "$LOG" | tail -1 || true

echo 'Latest melt-pool:'
if [ -f postProcessing/meltPoolDiagnostics/meltPool.csv ]; then
    tail -1 postProcessing/meltPoolDiagnostics/meltPool.csv | \
    awk -F',' '
    {
        printf "  L = %8.3f um    W = %8.3f um\n", $3*1e6, $4*1e6;
        printf "  D = %8.3f um    V = %8.6f mm^3\n", $5*1e6, $6*1e9;
        printf "  Tmax = %8.2f K  Umax = %8.3f m/s\n", $7, $8;
        printf "  recoil = %8.3f kPa  cells = %d\n", $9/1e3, $2;
    }'
else
    echo '  no meltPool.csv yet'
fi

echo 'Latest fusion-zone:'
if [ -f postProcessing/meltPoolDiagnostics/fusionZone.csv ]; then
    tail -1 postProcessing/meltPoolDiagnostics/fusionZone.csv | \
    awk -F',' '
    {
        printf "  L = %8.3f um    W = %8.3f um\n", $3*1e6, $4*1e6;
        printf "  D = %8.3f um    V = %8.6f mm^3\n", $5*1e6, $6*1e9;
        printf "  peakT = %8.2f K  cells = %d\n", $7, $2;
    }'
else
    echo '  no fusionZone.csv yet'
fi

echo 'Latest fusion-zone sections:'
if [ -f postProcessing/meltPoolDiagnostics/fusionZoneSections.csv ]; then
    python3 - <<'PY' || true
import csv
from pathlib import Path
p = Path("postProcessing/meltPoolDiagnostics/fusionZoneSections.csv")
with p.open(newline="") as f:
    rows = list(csv.DictReader(f))
if rows:
    t = max(float(r["time_s"]) for r in rows)
    for r in rows:
        if abs(float(r["time_s"]) - t) <= 1e-14:
            print(
                "  x={:+8.3f} mm  W={:8.3f} um  D={:8.3f} um  cells={}".format(
                    float(r["station_m"])*1e3,
                    float(r["width_m"])*1e6,
                    float(r["depth_m"])*1e6,
                    r["sectionCells"],
                )
            )
PY
else
    echo '  no fusionZoneSections.csv yet'
fi

echo 'Station-wise experiment comparison:'
if [ -f section-experiment-comparison.txt ]; then
    sed 's/^/  /' section-experiment-comparison.txt
elif [ -f postProcessing/meltPoolDiagnostics/fusionZoneSections.csv ]; then
    python3 CompareExperimentSections.py 2>/dev/null | sed 's/^/  /' || true
else
    echo '  no station-wise comparison yet'
fi

echo 'Experiment comparison:'
if [ -f calibration-comparison.txt ]; then
    sed 's/^/  /' calibration-comparison.txt
elif [ -f postProcessing/meltPoolDiagnostics/fusionZone.csv ]; then
    python3 CompareExperiment.py 2>/dev/null | sed 's/^/  /' || true
else
    echo '  no completed fusionZone.csv yet'
fi

echo 'Run health:'
ACTIVE=0
MPIRUN_PID=""
RANKS=0
EXPECTED=48

if command -v foamDictionary >/dev/null 2>&1; then
    N="$(foamDictionary system/decomposeParDict -entry numberOfSubdomains -value 2>/dev/null || true)"
    [[ "$N" =~ ^[0-9]+$ ]] && EXPECTED="$N"
fi

if [ -f run.pid ]; then
    RP="$(cat run.pid 2>/dev/null || true)"
    if [ -n "$RP" ] && kill -0 "$RP" 2>/dev/null; then
        ACTIVE=1
        printf '  Allrun PID = %s (active)\n' "$RP"
        MPIRUN_PID="$(pgrep -P "$RP" -f 'mpirun.*electronBeamFoam' | head -1 || true)"
    else
        printf '  run.pid = %s (not active)\n' "${RP:-unknown}"
    fi
else
    echo '  no run.pid'
fi

if [ -n "$MPIRUN_PID" ]; then
    RANKS="$(pgrep -P "$MPIRUN_PID" -f 'electronBeamFoam -parallel' | wc -l)"
    printf '  mpirun PID = %s\n' "$MPIRUN_PID"
    printf '  solver ranks = %s / %s\n' "$RANKS" "$EXPECTED"
    if [ "$RANKS" -gt 0 ]; then
        CHILD_PIDS="$(pgrep -P "$MPIRUN_PID" -f 'electronBeamFoam -parallel' | paste -sd, -)"
        if [ -n "$CHILD_PIDS" ]; then
            ps -p "$CHILD_PIDS" -o %cpu=,rss= 2>/dev/null | \
            awk '
                NR==1 {cmin=$1; cmax=$1; rmax=$2}
                {
                    csum+=$1;
                    if ($1<cmin) cmin=$1;
                    if ($1>cmax) cmax=$1;
                    if ($2>rmax) rmax=$2;
                }
                END {
                    if (NR>0)
                        printf "  rank CPU min/mean/max = %.1f / %.1f / %.1f %%\n  max rank RSS = %.1f MiB\n",
                            cmin, csum/NR, cmax, rmax/1024.0;
                }'
        fi
        TOTAL_SOLVER="$(pgrep -f 'electronBeamFoam -parallel' | wc -l)"
        printf '  system-wide solver processes = %s\n' "$TOTAL_SOLVER"
    fi
else
    echo '  mpirun not found under Allrun'
fi

if grep -Eq 'Connection reset by peer|Segmentation fault|Killed|Out of memory|FOAM FATAL ERROR|MPI_ABORT|BAD TERMINATION' "$LOG"; then
    echo '  FAILURE SIGNATURE detected in solver log.'
    grep -E 'Connection reset by peer|Segmentation fault|Killed|Out of memory|FOAM FATAL ERROR|MPI_ABORT|BAD TERMINATION' "$LOG" | tail -5 | sed 's/^/    /'
fi

if [ -f "$LOG" ]; then
    NOW="$(date +%s)"
    MTIME="$(stat -c %Y "$LOG" 2>/dev/null || echo "$NOW")"
    AGE=$((NOW - MTIME))
    printf '  log age = %d s\n' "$AGE"

    if [ "$ACTIVE" -eq 1 ] && [ "$AGE" -ge 300 ]; then
        echo '  WARNING: active wrapper but solver log has not advanced for >=300 s.'
        echo '  Last solver lines:'
        tail -8 "$LOG" | sed 's/^/    /'

        if [ -z "$MPIRUN_PID" ] || [ "$RANKS" -lt "$EXPECTED" ]; then
            echo '  State: FAILED/DEGRADED MPI job; waiting will not recover it.'
        elif tail -20 "$LOG" | grep -q 'Connection reset by peer'; then
            echo '  State: MPI peer failure during/after mesh update; waiting is not useful.'
        elif tail -20 "$LOG" | grep -Eq 'Selected .*cells for refinement|Refined from|Unrefined from'; then
            echo '  Suspect stage: dynamic mesh topology update / field mapping.'
        fi
    fi
fi
